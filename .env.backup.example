# アバターの認証と分離したバックアップ専用の権限。chmod 600。
DATABASE_URL=postgres://accounts:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/accounts
R2_BACKUP_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=lumorphia-accounts-backups
R2_BACKUP_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_KEY
R2_BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET
