# .env.production に写す。全て本番専用にし、chmod 600。
# compose の展開にも --env-file .env.production を渡す。
ACCOUNTS_TAG=sha-REPLACE_WITH_APPROVED_COMMIT
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgres://accounts:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/accounts
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_BASE_URL=https://accounts.lumorphia.com
# 通常ログインの戻り先。トップのセッション表示も、このオリジンだけに許可する。
WEBSITE_ORIGIN=https://lumorphia.com
PUBLIC_IMAGE_BASE_URL=https://accounts-images.lumorphia.com
NODE_ENV=production
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
# 起動・通知・復元の確認後に有効にする。web と worker で同じファイルを読む。
FEATURE_ACCOUNT_LIFECYCLE=0
FEATURE_LODESTONE=0
LODESTONE_BASE_URL=https://jp.finalfantasyxiv.com
LODESTONE_USER_AGENT=lumorphia-accounts/1.0 (https://accounts.lumorphia.com/terms)
LEGACY_PRISMTONE_MIGRATION_URL=https://prismtone.lumorphia.com/login
# Cloudflare を経由しない通信を VPS / Caddy で拒否してから設定。
CLIENT_IP_HEADER=cf-connecting-ip
STORAGE_DRIVER=s3
# platform/storage の R2 設定。アバター専用バケットへの権限に制限する。
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_BUCKET=lumorphia-accounts-avatars
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# 対応する固定プロバイダーの組を設定。
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# X は当面使わない。対応と設定項目は残し、ID・SECRET は未設定のままにする。
# AUTH_X_ID=
# AUTH_X_SECRET=
# Sentry の IP 保存を無効にし、保存期間を確認してから有効にする。
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
CSP_REPORT_ONLY=0
