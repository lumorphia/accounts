# 開発用の値。.env に写して使う (.env はコミットしない)
DATABASE_URL=postgres://accounts:accounts@localhost:5434/accounts
# ログイン。開発時の URL は Caddy の https 側。E2E は Playwright が上書きする
AUTH_BASE_URL=https://accounts.lumorphia.test:8443
AUTH_SECRET=dev-secret-dev-secret-dev-secret-0123
# 各プロバイダーを使うときだけ設定する
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_X_ID=
# AUTH_X_SECRET=
# Misskey / Mastodon。接続を禁止するホストはカンマ区切り
MIAUTH_BLOCKED_HOSTS=
# 開発・テスト専用のローカルホスト (本番では無視)
MIAUTH_DEV_HOSTS=
MASTODON_DEV_HOSTS=

# 開発中のアイコンはアプリ自身が配信。本番では R2 の公開 URL にする
PUBLIC_IMAGE_BASE_URL=https://accounts.lumorphia.test:8443/api/media
STORAGE_DRIVER=memory

# キャラクター worker (A1.3b)。API と画面は A1.3c で接続する
FEATURE_LODESTONE=0
LODESTONE_BASE_URL=https://jp.finalfantasyxiv.com
# 本番で取得するときはサービス名・版・連絡先を含める
# LODESTONE_USER_AGENT=

# 退会・復旧・通知の worker と API。運用の接続後に両方で有効にする
FEATURE_ACCOUNT_LIFECYCLE=0
