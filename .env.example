# 開発用の値。.env に写して使う (.env はコミットしない)
DATABASE_URL=postgres://accounts:accounts@localhost:5434/accounts
# ログイン。開発時の URL は Caddy の https 側。E2E は Playwright が上書きする
AUTH_BASE_URL=https://accounts.lumorphia.test:8443
AUTH_SECRET=dev-secret-dev-secret-dev-secret-0123
