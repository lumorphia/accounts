{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node", "vite/client", "react", "react-dom"]
  },
  "include": [
    ".react-router/types/**/*",
    "web/**/*",
    "server/**/*",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
