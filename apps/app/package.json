{
  "name": "@lumorphia-accounts/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env --import ./server/sentry.ts ./server/index.ts",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "worker:characters": "node --env-file-if-exists=../../.env --import ./server/sentry.ts ./server/character-worker.ts",
    "worker:accounts": "node --env-file-if-exists=../../.env --import ./server/sentry.ts ./server/account-worker.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.23",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/under-pressure": "^9.2.1",
    "@lumorphia-accounts/core": "workspace:*",
    "@lumorphia-accounts/db": "workspace:*",
    "@lumorphia/media": "1.0.0",
    "@lumorphia/ops": "1.0.0",
    "@lumorphia/storage": "1.0.0",
    "@mcansh/react-router-fastify": "^6.0.2",
    "@react-router/node": "^8.5.1",
    "@sentry/node": "^10.78.0",
    "@sentry/react": "^10.78.0",
    "better-auth": "1.7.23",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "isbot": "^5.2.3",
    "jose": "6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
